<Window x:Class="Dropzone.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropzone"
        Width="430" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        AllowDrop="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1E1F22"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#2A2C30"/>
        <SolidColorBrush x:Key="SurfaceRow" Color="#33363B"/>
        <SolidColorBrush x:Key="Accent" Color="#58A6FF"/>
        <SolidColorBrush x:Key="Danger" Color="#FF7B72"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA0A6"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0B0C0E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#3A3D42"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3D42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3D42"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill on/off switch -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="12" Background="#4A4E54"/>
                            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="11,6" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2C30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3D42"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#33363B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- One row in a transfer history list -->
        <DataTemplate x:Key="HistoryRow">
            <Border Background="{StaticResource SurfaceRow}" CornerRadius="8" Padding="9,7" Margin="0,0,0,5"
                    Cursor="Hand" MouseLeftButtonUp="HistoryRow_Click" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="15" Margin="0,0,9,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Summary}" Foreground="#F0F2F5" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#9AA0A6" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#9AA0A6" FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- One media file on the phone -->
        <DataTemplate x:Key="MediaRow">
            <Border Background="{StaticResource SurfaceRow}" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Foreground="#F0F2F5" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DateText}" Foreground="#9AA0A6" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#9AA0A6" FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dropzone" Foreground="{StaticResource TextPrimary}"
                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="HeaderReceiveSwitch" Style="{StaticResource Switch}"
                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Receiving on/off"
                                  Checked="HeaderSwitch_Changed" Unchecked="HeaderSwitch_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}"
                                  ToolTip="Keep window open when it loses focus"
                                  Content="📌" FontSize="13"/>
                    <Button x:Name="CloseButton" Style="{StaticResource Ghost}" Content="✕"
                            Padding="8,3" Margin="4,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="2,10,2,0">
                <TextBlock x:Name="StatusLine" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenRootButton" Style="{StaticResource Ghost}" Content="Folder"
                            Click="OpenRoot_Click"/>
                    <Button x:Name="QuitButton" Style="{StaticResource Ghost}" Content="Quit"
                            Margin="5,0,0,0" Click="Quit_Click"/>
                </StackPanel>
            </Grid>

            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True"/>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ============ SEND ============ -->
                <TabItem Header="Send">
                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Send to" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,8">
                                    <ComboBox x:Name="RecipientBox" DisplayMemberPath="Display" Margin="0,0,64,0"/>
                                    <Button x:Name="ScanButton" Style="{StaticResource Ghost}" Content="Scan"
                                            HorizontalAlignment="Right" Click="Scan_Click"/>
                                </Grid>

                                <Border x:Name="DropArea" Background="#33363B" CornerRadius="8"
                                        BorderBrush="#4A4E54" BorderThickness="1.5" MinHeight="62" Padding="8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DropText" Text="Drop files here, or use Add files"
                                                   Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        <ItemsControl x:Name="OutgoingList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#F0F2F5" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AddFilesButton" Style="{StaticResource Ghost}"
                                                Content="Add files…" Click="AddFiles_Click"/>
                                        <Button x:Name="ClearFilesButton" Style="{StaticResource Ghost}"
                                                Content="Clear" Margin="5,0,0,0" Click="ClearFiles_Click"/>
                                    </StackPanel>
                                    <Button x:Name="SendButton" Style="{StaticResource Chip}" Content="Send"
                                            HorizontalAlignment="Right" Click="Send_Click"/>
                                </Grid>

                                <Separator Margin="0,10" Background="#3A3D42"/>

                                <TextBlock Text="Message / command" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <TextBox x:Name="MessageBox" Margin="0,0,64,0"
                                             ToolTip="Send text. &quot;run &lt;script&gt;&quot; starts a script on the other device."/>
                                    <Button x:Name="SendTextButton" Style="{StaticResource Ghost}" Content="Send"
                                            HorizontalAlignment="Right" Click="SendText_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="Sent" Style="{StaticResource SectionTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="SentList" ItemTemplate="{StaticResource HistoryRow}"/>
                                <TextBlock x:Name="NoSentText" Text="Nothing sent yet" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ============ RECEIVE ============ -->
                <TabItem Header="Receive">
                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Receiving" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock x:Name="ReceivingHint" Style="{StaticResource Muted}" Margin="0,3,60,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="ReceiveSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="ReceiveSwitch_Changed" Unchecked="ReceiveSwitch_Changed"/>
                            </Grid>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource SectionTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ReceivedList" ItemTemplate="{StaticResource HistoryRow}"/>
                                <TextBlock x:Name="NoReceivedText" Text="Nothing received yet"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ============ IPHONE ============ -->
                <TabItem Header="iPhone">
                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Cable" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        <TextBlock x:Name="PhoneStatusText" Style="{StaticResource Muted}"
                                                   Margin="0,3,90,0"/>
                                    </StackPanel>
                                    <Button x:Name="PhoneScanButton" Style="{StaticResource Chip}" Content="Scan"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="PhoneScan_Click"/>
                                </Grid>
                                <ProgressBar x:Name="PhoneProgress" Height="4" Margin="0,9,0,0"
                                             Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                             Background="#3A3D42" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SelectAllButton" Style="{StaticResource Ghost}" Content="All"
                                        Click="SelectAll_Click"/>
                                <Button x:Name="SelectNoneButton" Style="{StaticResource Ghost}" Content="None"
                                        Margin="5,0,0,0" Click="SelectNone_Click"/>
                                <Button x:Name="OpenPhotosButton" Style="{StaticResource Ghost}" Content="Open folder"
                                        Margin="5,0,0,0" Click="OpenPhotos_Click"/>
                            </StackPanel>
                            <Button x:Name="ImportButton" Style="{StaticResource Chip}" Content="Import selected"
                                    HorizontalAlignment="Right" Click="Import_Click" IsEnabled="False"/>
                        </Grid>

                        <TabControl x:Name="MediaTabs" Background="Transparent" BorderThickness="0">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True"
                                                    Margin="0,0,0,6"/>
                                        <ContentPresenter ContentSource="SelectedContent"/>
                                    </DockPanel>
                                </ControlTemplate>
                            </TabControl.Template>

                            <TabItem x:Name="PhotosTab" Header="Photos">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PhotoList" ItemTemplate="{DynamicResource MediaRow}"/>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem x:Name="VideosTab" Header="Videos">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="VideoList" ItemTemplate="{DynamicResource MediaRow}"/>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </TabItem>

                <!-- ============ SCRIPTS ============ -->
                <TabItem Header="Scripts">
                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Remote start" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,60,0"
                                               Text="Let other devices start ticked scripts by sending &quot;run &lt;name&gt;&quot;"/>
                                </StackPanel>
                                <ToggleButton x:Name="RemoteScriptsSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="RemoteScripts_Changed" Unchecked="RemoteScripts_Changed"/>
                            </Grid>
                        </Border>

                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="OpenScriptsButton" Style="{StaticResource Ghost}"
                                    Content="Open scripts folder" HorizontalAlignment="Left"
                                    Click="OpenScripts_Click"/>
                            <Button x:Name="ReloadScriptsButton" Style="{StaticResource Ghost}" Content="Reload"
                                    HorizontalAlignment="Right" Click="ReloadScripts_Click"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ScriptList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="0,0,0,5" Foreground="#F0F2F5">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Info.DisplayName}" FontSize="12"
                                                               Foreground="#F0F2F5"/>
                                                </Expander.Header>
                                                <Border Background="#33363B" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Info.Name}" FontSize="10"
                                                                   Foreground="#9AA0A6" Margin="0,0,0,8"/>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="Run" Padding="12,5" FontSize="11"
                                                                        Background="#58A6FF" Foreground="#0B0C0E"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        Click="RunScript_Click" Tag="{Binding Info}"/>
                                                                <Button Content="Edit" Padding="12,5" FontSize="11"
                                                                        Margin="5,0,0,0"
                                                                        Background="#3A3D42" Foreground="#F0F2F5"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        Click="EditScript_Click" Tag="{Binding Info}"/>
                                                            </StackPanel>
                                                            <CheckBox Content="Remote" Foreground="#9AA0A6"
                                                                      FontSize="11" VerticalAlignment="Center"
                                                                      HorizontalAlignment="Right"
                                                                      IsChecked="{Binding RemoteEnabled, Mode=TwoWay}"
                                                                      Tag="{Binding Info}"
                                                                      Checked="RemoteScript_Changed"
                                                                      Unchecked="RemoteScript_Changed"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoScriptsText" Style="{StaticResource Muted}"
                                           Text="No scripts yet — drop .ps1 or .bat files into the Scripts folder"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
