<Window x:Class="Dropzone.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropzone"
        Width="340" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        AllowDrop="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1E1F22"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#2A2C30"/>
        <SolidColorBrush x:Key="Accent" Color="#58A6FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA0A6"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0B0C0E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#3A3D42"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Accent}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Dropzone" Foreground="{StaticResource TextPrimary}"
                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="AliasText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="FoldersButton" Style="{StaticResource Ghost}" Content="Folders…"
                        HorizontalAlignment="Left" Click="Folders_Click"/>
                <Button x:Name="QuitButton" Style="{StaticResource Ghost}" Content="Quit"
                        HorizontalAlignment="Right" Click="Quit_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Receiving toggle -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Receiving" Foreground="{StaticResource TextPrimary}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="ReceivingHint" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="ToggleButton" Style="{StaticResource Chip}" Content="Turn on"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- Send -->
                    <Border x:Name="DropArea" Style="{StaticResource Card}" MinHeight="86"
                            BorderBrush="#44484E" BorderThickness="1.5">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="DropText" Text="Drop files here to send"
                                       Foreground="{StaticResource TextMuted}" FontSize="12"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SendStatus" Foreground="{StaticResource Accent}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Peers -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Nearby devices" Foreground="{StaticResource TextPrimary}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <Button x:Name="RefreshButton" Style="{StaticResource Ghost}" Content="Scan"
                                        Padding="10,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="Refresh_Click"/>
                            </Grid>
                            <ItemsControl x:Name="PeerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33363B" CornerRadius="7" Padding="9,7" Margin="0,3,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Alias}" Foreground="#F0F2F5" FontSize="12"/>
                                                <TextBlock Text="{Binding Address}" HorizontalAlignment="Right"
                                                           Foreground="#9AA0A6" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoPeersText" Text="No devices found yet"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- iPhone import -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="iPhone by cable" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="PhoneStatusText" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ImportProgress" Height="4" Margin="0,0,0,8"
                                         Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                         Background="#3A3D42" BorderThickness="0"/>
                            <Grid>
                                <Button x:Name="ImportButton" Style="{StaticResource Chip}"
                                        Content="Import photos" HorizontalAlignment="Left" Click="Import_Click"/>
                                <Button x:Name="CancelImportButton" Style="{StaticResource Ghost}"
                                        Content="Cancel" HorizontalAlignment="Right"
                                        Visibility="Collapsed" Click="CancelImport_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
